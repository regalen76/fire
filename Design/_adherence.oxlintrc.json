{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/charts/**",
              "components/core/**",
              "components/data/**",
              "components/icons/**",
              "components/navigation/**",
              "components/photos/**",
              "ui_kits/finance-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Display|Plus Jakarta Sans|DM Sans))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Display, Plus Jakarta Sans, DM Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|email|collapsed|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, email, collapsed, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarsGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:srcs|size|overlap|max|style|key|ref|className|style|children)$/]",
        "message": "<AvatarsGroup> doesn't accept that prop. Declared props: srcs, size, overlap, max, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:count|dot|solid|outline)$/]",
        "message": "<Badge> variant must be one of 'count' | 'dot' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|blue|red|orange|gray)$/]",
        "message": "<Badge> tone must be one of 'green' | 'blue' | 'red' | 'orange' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Balance'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|amount|graphSrc|onMore|style|key|ref|className|style|children)$/]",
        "message": "<Balance> doesn't accept that prop. Declared props: title, amount, graphSrc, onMore, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|labels|max|ticks|height|barColor|style|key|ref|className|style|children)$/]",
        "message": "<BarChart> doesn't accept that prop. Declared props: data, labels, max, ticks, height, barColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|current|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, current, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|icon|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, icon, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|glass|ghost|text|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'glass' | 'ghost' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|subtitle|action|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, title, subtitle, action, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|soft|inset|row)$/]",
        "message": "<Card> variant must be one of 'default' | 'soft' | 'inset' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreditCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|number|validThru|cvv|image|style|key|ref|className|style|children)$/]",
        "message": "<CreditCard> doesn't accept that prop. Declared props: brand, number, validThru, cvv, image, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Gauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|caption|icon|minLabel|maxLabel|style|key|ref|className|style|children)$/]",
        "message": "<Gauge> doesn't accept that prop. Declared props: value, caption, icon, minLabel, maxLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HelpCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|cta|image|collapsed|onCta|style|key|ref|className|style|children)$/]",
        "message": "<HelpCard> doesn't accept that prop. Declared props: title, text, cta, image, collapsed, onCta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|tone|round|key|ref|className|style|children)$/]",
        "message": "<IconTile> doesn't accept that prop. Declared props: icon, size, tone, round."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg)$/]",
        "message": "<IconTile> size must be one of 'xs' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|navy|white|ghost)$/]",
        "message": "<IconTile> tone must be one of 'blue' | 'navy' | 'white' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|iconSrc|variant|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, icon, iconSrc, variant, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:field|search)$/]",
        "message": "<Input> variant must be one of 'field' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InvoiceItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|id|amount|format|onDownload|style|key|ref|className|style|children)$/]",
        "message": "<InvoiceItem> doesn't accept that prop. Declared props: date, id, amount, format, onDownload, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineChartSeries'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|data|color|key|ref|className|style|children)$/]",
        "message": "<LineChartSeries> doesn't accept that prop. Declared props: name, data, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineChartSeries'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|cyan|green)$/]",
        "message": "<LineChartSeries> color must be one of 'blue' | 'cyan' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|short|collapsed|divider|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: name, short, collapsed, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MiniStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|progress|style|key|ref|className|style|children)$/]",
        "message": "<MiniStat> doesn't accept that prop. Declared props: icon, label, value, progress, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|collapsed|badge|onClick|style|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: icon, label, active, collapsed, badge, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:trail|title|searchPlaceholder|searchIconSrc|userLabel|onSearch|actions|style|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: trail, title, searchPlaceholder, searchIconSrc, userLabel, onSearch, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonPhoto14'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|radius|alt|className|style|key|ref|className|style|children)$/]",
        "message": "<PersonPhoto14> doesn't accept that prop. Declared props: src, size, radius, alt, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonPhoto16'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|radius|alt|className|style|key|ref|className|style|children)$/]",
        "message": "<PersonPhoto16> doesn't accept that prop. Declared props: src, size, radius, alt, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonPhoto23'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|radius|alt|className|style|key|ref|className|style|children)$/]",
        "message": "<PersonPhoto23> doesn't accept that prop. Declared props: src, size, radius, alt, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonPhoto4'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|radius|alt|className|style|key|ref|className|style|children)$/]",
        "message": "<PersonPhoto4> doesn't accept that prop. Declared props: src, size, radius, alt, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|width|color|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, label, width, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|badge|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: id, label, icon, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:collapsed|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SidebarToggle> doesn't accept that prop. Declared props: collapsed, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|change|trend|icon|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, change, trend, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<StatCard> trend must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|label|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransactionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|amount|type|category|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TransactionItem> doesn't accept that prop. Declared props: title, meta, amount, type, category, onClick, style."
