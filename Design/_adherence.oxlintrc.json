      {
        "selector": "JSXOpeningElement[name.name='TransactionItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:income|expense|pending)$/]",
        "message": "<TransactionItem> type must be one of 'income' | 'expense' | 'pending'."
      }
    ]
  },
