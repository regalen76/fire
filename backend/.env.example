# Copy to backend/.env (git-ignored) and fill in. See README "Configuration".
HOST=127.0.0.1
PORT=3000

# Turso: libsql://<db>.turso.io + token, or a local file.
TURSO_DATABASE_URL=file:fire.db
# TURSO_AUTH_TOKEN=

# OpenAI-compatible endpoint with a vision model.
FIRE_LLM_BASE_URL=https://example.com/v1
FIRE_LLM_API_KEY=
FIRE_LLM_MODEL=glm-5.3-flash
# FIRE_LLM_JSON_MODE=json_schema

# Shared secret the iPhone Shortcut sends as "Authorization: Bearer ...".
# Generate one with: openssl rand -hex 32
FIRE_INGEST_TOKEN=

# Names on your bank / e-wallet accounts, comma-separated (decides transfer direction).
FIRE_OWNER_NAMES=
FIRE_BASE_CURRENCY=IDR
FIRE_DEFAULT_CURRENCY=IDR
FIRE_UTC_OFFSET=+07:00

# Serve the built frontend from the backend (production).
# FIRE_STATIC_DIR=../frontend/dist
